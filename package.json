{
  "name": "cdda-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract": "tsx tools/extract/index.ts",
    "data:all": "tsx tools/extract/all.ts",
    "extract:mapgen": "tsx tools/extract/mapgen.ts",
    "worldgen": "tsx tools/worldgen.ts",
    "extract:ui": "tsx tools/extract/ui.ts",
    "extract:vehicles": "tsx tools/extract/vehicles.ts",
    "extract:npcs": "tsx tools/extract/npcs.ts",
    "extract:achievements": "tsx tools/extract/achievements.ts",
    "atlas": "tsx tools/atlas/index.ts",
    "shot": "tsx tools/shot.ts",
    "sim": "NODE_OPTIONS='--import ./tools/lib/css-register.mjs' tsx tools/balance_sim.ts",
    "audio": "tsx tools/audio/index.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
